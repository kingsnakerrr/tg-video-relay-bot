# Required. Create it with @BotFather.
BOT_TOKEN=123456789:replace_me

# Public API by default. For original-quality large uploads, run a local Telegram Bot API server
# and set BOT_API_BASE_URL=http://127.0.0.1:8081 plus BOT_API_USE_LOCAL_FILE_URI=true.
BOT_API_BASE_URL=https://api.telegram.org
BOT_API_USE_LOCAL_FILE_URI=false

# Required. Comma-separated channel/group IDs or @usernames.
# Examples:
# TARGET_CHAT_IDS=-1001234567890,@your_channel_username
TARGET_CHAT_IDS=

# Recommended. Comma-separated Telegram user IDs allowed to submit URLs.
# Send /id to the bot to see your user ID. Empty means anyone who can message the bot can submit jobs.
ALLOWED_USER_IDS=

# Optional download/cache behavior. Absolute path is recommended on VPS.
# Example: DOWNLOAD_DIR=/data/opt/tg-video-relay-bot/downloads
DOWNLOAD_DIR=/opt/tg-video-relay-bot/downloads
# Prefer the highest available video plus audio. Exact resolution buttons still use their own format selector.
DOWNLOAD_FORMAT=bv*+ba/best
MERGE_OUTPUT_FORMAT=mp4
MAX_FILE_MB=1900

# Public Telegram Bot API commonly rejects uploads above about 50 MB.
# Keep this at 49 unless you run your own local Telegram Bot API server.
# Original-quality large upload mode:
# BOT_API_BASE_URL=http://127.0.0.1:8081
# BOT_API_USE_LOCAL_FILE_URI=true
# MAX_UPLOAD_MB=1900
# AUTO_COMPRESS=false
MAX_UPLOAD_MB=49
AUTO_COMPRESS=true
COMPRESS_AUDIO_KBPS=96
COMPRESS_MIN_VIDEO_KBPS=60

# yt-dlp download tuning. These help YouTube/TikTok on many VPS networks.
YTDLP_FORCE_IPV4=true
YTDLP_HTTP_CHUNK_SIZE=10M
YTDLP_PROXY=
YTDLP_PROXY_TIKTOK=
YTDLP_PROXY_DOUYIN=
YTDLP_PROXY_PORNHUB=
YOUTUBE_PLAYER_CLIENTS=web,web_safari,ios,android

# Optional cookie support. Put Netscape-format cookies files on the VPS.
# X/Twitter, YouTube and Pornhub use separate cookie files. COOKIES_FILE is a legacy fallback.
COOKIES_FILE=
COOKIES_FILE_X=/opt/tg-video-relay-bot/cookies_x.txt
COOKIES_FILE_YOUTUBE=/opt/tg-video-relay-bot/cookies_youtube.txt
COOKIES_FILE_PORNHUB=/opt/tg-video-relay-bot/cookies_pornhub.txt
COOKIES_FILE_TIKTOK=/opt/tg-video-relay-bot/cookies_tiktok.txt
COOKIES_FILE_DOUYIN=/opt/tg-video-relay-bot/cookies_douyin.txt
COOKIE_SYNC_URL=
COOKIE_SYNC_URL_X=
COOKIE_SYNC_URL_YOUTUBE=
COOKIE_SYNC_URL_PORNHUB=
COOKIE_SYNC_URL_TIKTOK=
COOKIE_SYNC_URL_DOUYIN=
COOKIE_SYNC_INTERVAL_MINUTES=360

# Upload as video when possible. Set to document if Telegram refuses some videos.
UPLOAD_MODE=video

# Delete only after every configured target chat receives the upload.
DELETE_AFTER_ALL_UPLOADS=true

# Network timeouts in seconds.
BOT_API_TIMEOUT=30
UPLOAD_TIMEOUT=1800
UPLOAD_RETRIES=3

# Polling behavior.
POLL_TIMEOUT=50
WORKER_COUNT=1

# Telegram chat behavior. iPhone Shortcut and Chrome submit use the default DOWNLOAD_FORMAT.
TELEGRAM_RESOLUTION_MENU=true
# If nobody taps a resolution button in Telegram, auto-download highest quality after this many seconds.
TELEGRAM_RESOLUTION_AUTO_SECONDS=3

# Optional HTTP submit API for iPhone Shortcuts.
# Keep SUBMIT_API_SECRET private. Use HTTPS reverse proxy if possible.
SUBMIT_API_ENABLED=true
SUBMIT_API_HOST=0.0.0.0
SUBMIT_API_PORT=8787
SUBMIT_API_SECRET=change_me_to_a_long_random_secret
SUBMIT_NOTIFY_CHAT_ID=
